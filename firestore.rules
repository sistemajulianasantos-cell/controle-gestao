rules_version = '2';

/* ============================================================
   REGRAS DE SEGURANÇA — Firestore do Controle e Gestão
   ============================================================
   Só lê/grava quem entrou com uma senha que tem conta de acesso
   (acessos/<uid>, criada no login — ver _fbEntrar no index.html).
   Visitante sem senha (sessão anônima) não lê nem grava nada.
   Só Administrador mexe em acessos/ e na lista de senhas.

   Como aplicar: Console do Firebase → projeto controle-e-gestao-93c69
   → Firestore Database → Regras → colar este arquivo → Publicar.
   SÓ PUBLICAR quando Segurança mostrar "Todos já têm conta".
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function liberado() {
      return logado() && exists(/databases/$(database)/documents/acessos/$(request.auth.uid));
    }
    function ehAdmin() {
      return liberado()
        && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.p == 'admin';
    }

    match /acessos/{uid} {
      allow get:   if logado() && (request.auth.uid == uid || ehAdmin());
      allow list:  if ehAdmin();
      allow write: if ehAdmin();
    }

    match /dados/{id} {
      allow read:  if liberado();
      allow write: if liberado() && (id != 'senhas' || ehAdmin());
    }

    match /comprovantes/{id=**} { allow read, write: if liberado(); }
    match /backups/{id=**}      { allow read, write: if liberado(); }

    // Qualquer outra coleção: fechada.
  }
}
